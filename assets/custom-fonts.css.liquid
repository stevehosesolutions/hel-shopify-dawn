@font-face {
  font-family: "Barlow Condensed";
  font-style: normal;
  font-weight: 800;
  font-display: swap;

  src: url('{{ "BarlowCondensed-ExtraBold.woff2" | asset_url }}')
    format("woff2");
}

@font-face {
  font-family: "Barlow Condensed Italic";
  font-style: italic;
  font-weight: 800;
  font-display: swap;

  src: url('{{ "BarlowCondensed-ExtraBoldItalic.woff2" | asset_url }}')
    format("woff2");
}