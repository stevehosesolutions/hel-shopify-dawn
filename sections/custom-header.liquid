{{ 'custom-header.css' | asset_url | stylesheet_tag }}

<header class="custom-header">

  <!-- =========================================================
       Utility bar
       Desktop only
       ========================================================= -->

  <div class="custom-header__utility">
    <div class="custom-header__utility-inner page-width">

      <div class="custom-header__help">
        {% if section.settings.help_url != blank %}
          <a
            href="{{ section.settings.help_url }}"
            class="custom-header__utility-link"
          >
            <span class="custom-header__utility-icon" aria-hidden="true">
              <!-- Help icon -->
            </span>

            <span>Help Centre</span>
          </a>
        {% endif %}
      </div>


     {% assign message_count = 0 %}

    {% for block in section.blocks %}
      {% if block.type == 'header_message' %}
        {% assign message_count = message_count | plus: 1 %}
      {% endif %}
    {% endfor %}


    <div class="custom-header__messages">

      <div class="custom-header__messages-track">

        {% assign message_index = 0 %}

        {% for block in section.blocks %}

          {% if block.type == 'header_message' %}

            <div
              class="custom-header__message{% if message_index == 0 %} is-active{% endif %}"
              data-message-index="{{ message_index }}"
              {{ block.shopify_attributes }}
            >
              <div class="custom-header__message-content">
                {{ block.settings.content }}
              </div>
            </div>

            {% assign message_index = message_index | plus: 1 %}

          {% endif %}

        {% endfor %}

      </div>


      {% if message_count > 1 %}

        <div
          class="custom-header__message-pagination"
          aria-label="Header messages"
        >

          {% assign dot_index = 0 %}

          {% for block in section.blocks %}

            {% if block.type == 'header_message' %}

              <button
                type="button"
                class="custom-header__message-dot{% if dot_index == 0 %} is-active{% endif %}"
                data-message-index="{{ dot_index }}"
                aria-label="Show message {{ dot_index | plus: 1 }}"
                {% if dot_index == 0 %}
                  aria-current="true"
                {% endif %}
              ></button>

              {% assign dot_index = dot_index | plus: 1 %}

            {% endif %}

          {% endfor %}

        </div>

      {% endif %}

    </div>



      <div class="custom-header__social">
        <span class="custom-header__social-label">
          Follow us
        </span>

        <div class="custom-header__social-links">
          <!-- Social icons later -->
        </div>
      </div>

    </div>
  </div>


  <!-- =========================================================
       Main header
       Hamburger / Logo / Actions
       ========================================================= -->

  <div class="custom-header__main">
    <div class="custom-header__main-inner page-width">

      <!--
        Mobile navigation trigger lives inside your existing
        custom navigation system, so this is just its placement area.
      -->
      <div class="custom-header__main-left">

        <div class="custom-header__mobile-navigation">
          <!-- We will move/reference the existing hamburger here next -->
        </div>

      </div>


      <div class="custom-header__main-centre">

        <div class="custom-header__logo">
          <a href="{{ routes.root_url }}">

            {% if settings.logo != blank %}

              {{
                settings.logo
                | image_url: width: 400
                | image_tag:
                  alt: shop.name,
                  loading: 'eager'
              }}

            {% else %}

              {{ shop.name }}

            {% endif %}

          </a>
        </div>

      </div>


      <div class="custom-header__main-right">

        <div class="custom-header__actions">

          <a
            href="#"
            class="custom-header__action custom-header__action--dealer"
          >
            <span
              class="custom-header__action-icon"
              aria-hidden="true"
            >
              <!-- Dealer/location icon -->
            </span>

            <span class="custom-header__action-label">
              Find a Dealer
            </span>
          </a>


          <button
            type="button"
            class="custom-header__action custom-header__action--search"
            aria-label="Search"
          >
            <span
              class="custom-header__action-icon"
              aria-hidden="true"
            >
              <!-- Search icon -->
            </span>

            <span class="custom-header__action-label">
              Search
            </span>
          </button>


          {% if shop.customer_accounts_enabled %}

            <a
              href="{{ routes.account_url }}"
              class="custom-header__action custom-header__action--account"
            >
              <span
                class="custom-header__action-icon"
                aria-hidden="true"
              >
                <!-- Account icon -->
              </span>

              <span class="custom-header__action-label">
                Account
              </span>
            </a>

          {% endif %}


          <a
            href="{{ routes.cart_url }}"
            class="custom-header__action custom-header__action--basket"
          >

            <span
              class="custom-header__action-icon"
              aria-hidden="true"
            >
              <!-- Basket icon -->
            </span>

            <span class="custom-header__action-label">
              Basket
            </span>

            {% if cart.item_count > 0 %}
              <span class="custom-header__basket-count">
                {{ cart.item_count }}
              </span>
            {% endif %}

          </a>

        </div>

      </div>

    </div>
  </div>


  <!-- =========================================================
       Site switcher
       ========================================================= -->

  <div class="custom-header__switcher-row">

    <div class="custom-header__switcher">

      <span class="custom-header__switcher-title">
        Switch site
      </span>

      <div class="custom-header__switcher-options">

        <a
          href="#"
          class="custom-header__site custom-header__site--active"
          aria-current="page"
        >
          <span class="custom-header__site-icon" aria-hidden="true">
            <!-- Moto icon -->
          </span>

          <span>Moto</span>
        </a>


        <a
          href="#"
          class="custom-header__site"
        >
          <span class="custom-header__site-icon" aria-hidden="true">
            <!-- Auto icon -->
          </span>

          <span>Auto</span>
        </a>


        <a
          href="#"
          class="custom-header__site"
        >
          <span class="custom-header__site-icon" aria-hidden="true">
            <!-- MTB icon -->
          </span>

          <span>MTB</span>
        </a>

      </div>

    </div>

  </div>


  <!-- =========================================================
       Navigation
       Existing custom navigation
       ========================================================= -->

  <div class="custom-header__navigation">
    <div class="custom-header__navigation-inner page-width">

      <div class="custom-header__navigation-menu">

        {% render 'custom-nav-data' %}
        {% render 'custom-navigation' %}

      </div>


      <div class="custom-header__search">

        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="custom-header__search-form"
        >

          <input
            type="search"
            name="q"
            class="custom-header__search-input"
            placeholder="Search products, parts, applications..."
            aria-label="Search"
          >

          <button
            type="submit"
            class="custom-header__search-button"
            aria-label="Search"
          >
            <!-- Search icon -->
          </button>

        </form>

      </div>

    </div>
  </div>

</header>


{% schema %}
{
  "name": "Custom header",
  "class": "section-custom-header",

  "enabled_on": {
    "groups": ["header"]
  },

  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "url",
      "id": "help_url",
      "label": "Help centre link"
    }
  ],

  "blocks": [
    {
      "type": "navigation_group",
      "name": "Navigation group",
      "settings": [
        {
          "type": "text",
          "id": "parent",
          "label": "Parent menu item"
        },
        {
          "type": "text",
          "id": "group",
          "label": "Group"
        },
        {
          "type": "select",
          "id": "render",
          "label": "Display",
          "options": [
            {
              "value": "list",
              "label": "List"
            },
            {
              "value": "grid",
              "label": "Grid"
            }
          ],
          "default": "list"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Key"
        },
        {
          "type": "range",
          "id": "desktop_column",
          "label": "Desktop column",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 1
        }
      ]
    },
    {
      "type": "navigation_item",
      "name": "Navigation item",
      "settings": [
        {
          "type": "text",
          "id": "parent",
          "label": "Parent menu item"
        },
        {
          "type": "text",
          "id": "group",
          "label": "Group"
        },
        {
          "type": "text",
          "id": "item",
          "label": "Menu item"
        },
        {
          "type": "text",
          "id": "label_note",
          "label": "Label note"
        }
      ]
    },
      {
      "type": "header_message",
      "name": "Header message",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "content",
          "label": "Message"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Custom header"
    }
  ]
}
{% endschema %}