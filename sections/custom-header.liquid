{{ 'custom-header.css' | asset_url | stylesheet_tag }}

<header class="custom-header">

  <div class="custom-header__utility">
    <div class="custom-header__utility-inner page-width">

      <div class="custom-header__help">
        {% if section.settings.help_url != blank %}
          <a href="{{ section.settings.help_url }}">
            Help Centre
          </a>
        {% endif %}
      </div>

      <div class="custom-header__dispatch">
        {{ section.settings.dispatch_text }}
      </div>

      <div class="custom-header__social">
        Follow us
      </div>

    </div>
  </div>


  <div class="custom-header__main">
    <div class="custom-header__main-inner page-width">

      <div class="custom-header__main-left">
        <div class="custom-header__switcher">
          Site switcher
        </div>
      </div>

      <div class="custom-header__main-centre">
        <div class="custom-header__logo">
          <a href="{{ routes.root_url }}">
            {% if settings.logo != blank %}
              {{
                settings.logo
                | image_url: width: 400
                | image_tag:
                  alt: shop.name,
                  loading: 'eager'
              }}
            {% else %}
              {{ shop.name }}
            {% endif %}
          </a>
        </div>
      </div>

      <div class="custom-header__main-right">
        <div class="custom-header__actions">

          <a href="#">
            Find a Dealer
          </a>

          {% if shop.customer_accounts_enabled %}
            <a href="{{ routes.account_url }}">
              Account
            </a>
          {% endif %}

          <a href="{{ routes.cart_url }}">
            Basket

            {% if cart.item_count > 0 %}
              <span>
                {{ cart.item_count }}
              </span>
            {% endif %}
          </a>

        </div>
      </div>

    </div>
  </div>


  <div class="custom-header__navigation">

    {% render 'custom-nav-data' %}
    {% render 'custom-navigation' %}

  </div>

</header>


{% schema %}
{
  "name": "Custom header",
  "class": "section-custom-header",

  "enabled_on": {
    "groups": ["header"]
  },

  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "url",
      "id": "help_url",
      "label": "Help centre link"
    },
    {
      "type": "text",
      "id": "dispatch_text",
      "label": "Dispatch text",
      "default": "Same day dispatch – order by 3:30pm (Mon–Fri)"
    }
  ],

  "blocks": [
    {
      "type": "navigation_group",
      "name": "Navigation group",
      "settings": [
        {
          "type": "text",
          "id": "parent",
          "label": "Parent menu item"
        },
        {
          "type": "text",
          "id": "group",
          "label": "Group"
        },
        {
          "type": "select",
          "id": "render",
          "label": "Display",
          "options": [
            {
              "value": "list",
              "label": "List"
            },
            {
              "value": "grid",
              "label": "Grid"
            }
          ],
          "default": "list"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Key"
        },
        {
          "type": "range",
          "id": "desktop_column",
          "label": "Desktop column",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 1
        }
      ]
    },
    {
      "type": "navigation_item",
      "name": "Navigation item",
      "settings": [
        {
          "type": "text",
          "id": "parent",
          "label": "Parent menu item"
        },
        {
          "type": "text",
          "id": "group",
          "label": "Group"
        },
        {
          "type": "text",
          "id": "item",
          "label": "Menu item"
        },
        {
          "type": "text",
          "id": "label_note",
          "label": "Label note"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Custom header"
    }
  ]
}
{% endschema %}