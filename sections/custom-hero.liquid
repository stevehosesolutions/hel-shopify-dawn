{{ 'custom-hero.css' | asset_url | stylesheet_tag }}

<section class="custom-hero">

  <div class="custom-hero__slides">

    {% if section.blocks.size > 1 %}

      <div
        class="custom-hero__navigation page-width"
        aria-label="Hero slides"
      >

        <div class="custom-hero__navigation-inner">

          {% for block in section.blocks %}

            <button
              type="button"
              class="
                custom-hero__navigation-button
                {% if forloop.first %}is-active{% endif %}
              "
              data-hero-slide="{{ forloop.index0 }}"
              aria-label="Show slide {{ forloop.index }}"
              {% if forloop.first %}
                aria-current="true"
              {% endif %}
            >
            <span class="custom-hero__navigation-label">

              {% if block.settings.navigation_label != blank %}

                {{ block.settings.navigation_label }}

              {% else %}

                {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}

              {% endif %}

            </span>
            </button>

          {% endfor %}

          <span
            class="custom-hero__navigation-indicator"
            aria-hidden="true"
          ></span>

        </div>

      </div>

    {% endif %}



    {% for block in section.blocks %}

      {% assign overlay_strength = block.settings.overlay_strength_percent | divided_by: 100.0 %}

      <div
        class="
          custom-hero__slide
          custom-hero--desktop-{{ block.settings.desktop_content_position }}
          custom-hero--mobile-{{ block.settings.mobile_content_position }}
          custom-hero--theme-{{ block.settings.content_theme }}
          custom-hero--accent-{{ block.settings.heading_accent }}
          custom-hero--heading-{{ block.settings.heading_size }}
          custom-hero--heading-{{ block.settings.heading_emphasis }}
          custom-hero--button-size-{{ block.settings.button_size }}
          {% if forloop.first %}is-active{% endif %}
        "
        data-hero-theme="{{ block.settings.content_theme }}"
        data-hero-slide="{{ forloop.index0 }}"
        style="
          --hero-position-x: {{ block.settings.desktop_position_x }}%;
          --hero-mobile-position-x: {{ block.settings.mobile_position_x }}%;

          --hero-overlay-strong: {{ 0.84 | times: overlay_strength }};
          --hero-overlay-medium: {{ 0.56 | times: overlay_strength }};
          --hero-overlay-soft: {{ 0.22 | times: overlay_strength }};
          --hero-overlay-extra-soft: {{ 0.09 | times: overlay_strength }};
        "
        {{ block.shopify_attributes }}
      >

        <div class="custom-hero__media">

          <picture>

            {% if block.settings.mobile_image != blank %}
              <source
                media="(max-width: 1199px)"
                srcset="
                  {{ block.settings.mobile_image | image_url: width: 480 }} 480w,
                  {{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                  {{ block.settings.mobile_image | image_url: width: 960 }} 960w,
                  {{ block.settings.mobile_image | image_url: width: 1200 }} 1200w
                "
                sizes="100vw"
              >
            {% endif %}

            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 2560
                | image_tag:
                  class: 'custom-hero__image',
                  alt: block.settings.image.alt,
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '960, 1280, 1600, 1920, 2560',
                  sizes: '100vw'
              }}
            {% endif %}

          </picture>

        </div>


        <div class="custom-hero__content page-width">

          <div class="custom-hero__content-inner">

            {% if block.settings.eyebrow != blank %}
              <div class="custom-hero__eyebrow">
                {{ block.settings.eyebrow }}
              </div>
            {% endif %}


            {% if block.settings.heading_line_1 != blank or block.settings.heading_line_2 != blank %}
              <h1 class="custom-hero__heading">

                {% if block.settings.heading_line_1 != blank %}
                  <span class="custom-hero__heading-line">
                    {{ block.settings.heading_line_1 }}
                  </span>
                {% endif %}

                {% if block.settings.heading_line_2 != blank %}
                  <span class="custom-hero__heading-line">
                    {{ block.settings.heading_line_2 }}
                  </span>
                {% endif %}

              </h1>
            {% endif %}


            {% if block.settings.subheading_line_1 != blank or block.settings.subheading_line_2 != blank %}
              <div class="custom-hero__subheading">

                {% if block.settings.subheading_line_1 != blank %}
                  <div class="custom-hero__subheading-line">
                    {{ block.settings.subheading_line_1 }}
                  </div>
                {% endif %}

                {% if block.settings.subheading_line_2 != blank %}
                  <div class="custom-hero__subheading-line">
                    {{ block.settings.subheading_line_2 }}
                  </div>
                {% endif %}

              </div>
            {% endif %}


            {% if
              block.settings.button_text != blank and block.settings.button_link != blank
              or
              block.settings.secondary_button_text != blank and block.settings.secondary_button_link != blank
            %}

              <div class="custom-hero__buttons">

                {% if block.settings.button_text != blank and block.settings.button_link != blank %}
                  <a
                    class="
                      custom-hero__button
                      custom-hero__button--primary
                      custom-hero__button--{{ block.settings.button_style }}
                      {% if block.settings.button_show_arrow %}custom-hero__button--arrow{% endif %}
                    "
                    href="{{ block.settings.button_link }}"
                  >
                    <span class="custom-hero__button-text">
                      {{ block.settings.button_text }}
                    </span>
                  </a>
                {% endif %}


                {% if block.settings.secondary_button_text != blank and block.settings.secondary_button_link != blank %}
                  <a
                    class="
                      custom-hero__button
                      custom-hero__button--secondary
                      custom-hero__button--{{ block.settings.secondary_button_style }}
                      {% if block.settings.secondary_button_show_arrow %}custom-hero__button--arrow{% endif %}
                    "
                    href="{{ block.settings.secondary_button_link }}"
                  >
                    <span class="custom-hero__button-text">
                      {{ block.settings.secondary_button_text }}
                    </span>
                  </a>
                {% endif %}

              </div>

            {% endif %}

          </div>

        </div>

      </div>

    {% endfor %}

  </div>

</section>


{% schema %}
{
  "name": "Custom hero",

  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "min": 4,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slide every",
      "default": 6
    }
  ],

  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "navigation_label",
          "label": "Navigation label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "header",
          "content": "Desktop image position"
        },
        {
          "type": "range",
          "id": "desktop_position_x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "header",
          "content": "Mobile image position"
        },
        {
          "type": "range",
          "id": "mobile_position_x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "header",
          "content": "Content layout"
        },
        {
          "type": "select",
          "id": "desktop_content_position",
          "label": "Desktop position",
          "options": [
            {
              "value": "top-left",
              "label": "Top left"
            },
            {
              "value": "top-centre",
              "label": "Top centre"
            },
            {
              "value": "top-right",
              "label": "Top right"
            },
            {
              "value": "centre-left",
              "label": "Centre left"
            },
            {
              "value": "centre",
              "label": "Centre"
            },
            {
              "value": "centre-right",
              "label": "Centre right"
            },
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "bottom-centre",
              "label": "Bottom centre"
            },
            {
              "value": "bottom-right",
              "label": "Bottom right"
            }
          ],
          "default": "bottom-left"
        },
        {
          "type": "select",
          "id": "mobile_content_position",
          "label": "Mobile position",
          "options": [
            {
              "value": "top-left",
              "label": "Top left"
            },
            {
              "value": "top-centre",
              "label": "Top centre"
            },
            {
              "value": "top-right",
              "label": "Top right"
            },
            {
              "value": "centre-left",
              "label": "Centre left"
            },
            {
              "value": "centre",
              "label": "Centre"
            },
            {
              "value": "centre-right",
              "label": "Centre right"
            },
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "bottom-centre",
              "label": "Bottom centre"
            },
            {
              "value": "bottom-right",
              "label": "Bottom right"
            }
          ],
          "default": "bottom-left"
        },
        {
          "type": "select",
          "id": "content_theme",
          "label": "Content theme",
          "options": [
            {
              "value": "light",
              "label": "Light"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ],
          "default": "light"
        },
        {
          "type": "range",
          "id": "overlay_strength_percent",
          "label": "Overlay strength",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 70
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "default": "large"
        },
        {
          "type": "select",
          "id": "heading_emphasis",
          "label": "Heading emphasis",
          "options": [
