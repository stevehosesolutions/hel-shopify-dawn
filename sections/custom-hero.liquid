          ],
          "default": "line-1"
        },
        {
          "type": "inline_richtext",
          "id": "heading_line_1",
          "label": "Heading - line 1"
        },
        {
          "type": "inline_richtext",
          "id": "heading_line_2",
          "label": "Heading - line 2"
        },
        {
          "type": "inline_richtext",
          "id": "subheading_line_1",
          "label": "Subheading - line 1"
        },
        {
          "type": "inline_richtext",
          "id": "subheading_line_2",
          "label": "Subheading - line 2"
        },
        {
          "type": "header",
          "content": "Primary button"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "text",
              "label": "Text link"
            },
            {
              "value": "solid",
              "label": "Solid"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "text"
        },
        {
          "type": "select",
          "id": "button_size",
          "label": "Button size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
