        {
          "type": "header",
          "content": "Secondary button"
        },
        {
          "type": "text",
          "id": "secondary_button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "secondary_button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "secondary_button_style",
          "label": "Button style",
          "options": [
            {
              "value": "text",
              "label": "Text link"
            },
            {
              "value": "solid",
              "label": "Solid"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "text"
        },
        {
          "type": "checkbox",
          "id": "secondary_button_show_arrow",
          "label": "Show arrow",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom hero",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}