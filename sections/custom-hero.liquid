{{ 'custom-hero.css' | asset_url | stylesheet_tag }}

<section
  class="custom-hero"
    style="
    --hero-position-x: {{ section.settings.desktop_position_x }}%;
    --hero-mobile-position-x: {{ section.settings.mobile_position_x }}%;
  "
>

  <div class="custom-hero__media">

    <picture>

      {% if section.settings.mobile_image != blank %}
        <source
          media="(max-width: 1199px)"
          srcset="
            {{ section.settings.mobile_image | image_url: width: 480 }} 480w,
            {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
            {{ section.settings.mobile_image | image_url: width: 960 }} 960w,
            {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w
          "
          sizes="100vw"
        >
      {% endif %}

      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2560
          | image_tag:
            class: 'custom-hero__image',
            alt: section.settings.image.alt,
            loading: 'eager',
            fetchpriority: 'high',
            widths: '960, 1280, 1600, 1920, 2560',
            sizes: '100vw'
        }}
      {% endif %}

    </picture>

  </div>



  <div class="custom-hero__content page-width">

    <div class="custom-hero__content-inner">

      {% if section.settings.eyebrow != blank %}
        <div class="custom-hero__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}


      {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
        <h1 class="custom-hero__heading">

          {% if section.settings.heading_line_1 != blank %}
            <span class="custom-hero__heading-line">
              {{ section.settings.heading_line_1 }}
            </span>
          {% endif %}

          {% if section.settings.heading_line_2 != blank %}
            <span class="custom-hero__heading-line">
              {{ section.settings.heading_line_2 }}
            </span>
          {% endif %}

        </h1>
      {% endif %}


      {% if section.settings.subheading_line_1 != blank or section.settings.subheading_line_2 != blank %}
        <div class="custom-hero__subheading">

          {% if section.settings.subheading_line_1 != blank %}
            <div class="custom-hero__subheading-line">
              {{ section.settings.subheading_line_1 }}
            </div>
          {% endif %}

          {% if section.settings.subheading_line_2 != blank %}
            <div class="custom-hero__subheading-line">
              {{ section.settings.subheading_line_2 }}
            </div>
          {% endif %}

        </div>
      {% endif %}


      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a
          class="custom-hero__button"
          href="{{ section.settings.button_link }}"
        >
          {{ section.settings.button_text }}
        </a>
      {% endif %}

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Custom hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Desktop image position"
    },
    {
      "type": "range",
      "id": "desktop_position_x",
      "label": "Horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile image position"
    },
    {
      "type": "range",
      "id": "mobile_position_x",
      "label": "Horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "richtext",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading_line_1",
      "label": "Heading - line 1"
    },
    {
      "type": "inline_richtext",
      "id": "heading_line_2",
      "label": "Heading - line 2"
    },
    {
      "type": "richtext",
      "id": "subheading_line_1",
      "label": "Subheading - line 1"
    },
    {
      "type": "richtext",
      "id": "subheading_line_2",
      "label": "Subheading - line 2"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Custom hero"
    }
  ]
}
{% endschema %}