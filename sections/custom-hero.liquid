{{ 'custom-hero.css' | asset_url | stylesheet_tag }}

<section class="custom-hero">

  <div class="custom-hero__media">

    <picture>

      {% if section.settings.mobile_image != blank %}
        <source
          media="(max-width: 1199px)"
          srcset="{{ section.settings.mobile_image | image_url: width: 1600 }}"
        >
      {% endif %}

      {% if section.settings.image != blank %}

        {{
          section.settings.image
          | image_url: width: 3000
          | image_tag:
            class: 'custom-hero__image',
            alt: section.settings.image.alt,
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 2000, 2500, 3000',
            sizes: '100vw'
        }}

      {% endif %}

    </picture>

  </div>


  {% if section.settings.overlay_opacity > 0 %}
    <div
      class="custom-hero__overlay"
      style="--hero-overlay-opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    ></div>
  {% endif %}


  <div class="custom-hero__content page-width">

    <div class="custom-hero__content-inner">

      {% if section.settings.eyebrow != blank %}
        <div class="custom-hero__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}


      {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
        <h1 class="custom-hero__heading">
          <span class="custom-hero__heading-line">
            {{ section.settings.heading_line_1 }}
          </span>

          <span class="custom-hero__heading-line">
            {{ section.settings.heading_line_2 }}
          </span>
        </h1>
      {% endif %}


      {% if section.settings.subheading_line_1 != blank or section.settings.subheading_line_2 != blank %}
        <div class="custom-hero__subheading">

          {% if section.settings.subheading_line_1 != blank %}
            <div class="custom-hero__subheading-line">
              {{ section.settings.subheading_line_1 }}
            </div>
          {% endif %}

          {% if section.settings.subheading_line_2 != blank %}
            <div class="custom-hero__subheading-line">
              {{ section.settings.subheading_line_2 }}
            </div>
          {% endif %}

        </div>
      {% endif %}


      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a
          class="custom-hero__button"
          href="{{ section.settings.button_link }}"
        >
          {{ section.settings.button_text }}
        </a>
      {% endif %}

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Custom hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "richtext",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
{
  "type": "inline_richtext",
  "id": "heading_line_1",
  "label": "Heading - line 1"
},
{
  "type": "inline_richtext",
  "id": "heading_line_2",
  "label": "Heading - line 2"
},
    {
      "type": "richtext",
      "id": "subheading_line_1",
      "label": "Subheading - line 1"
    },
    {
      "type": "richtext",
      "id": "subheading_line_2",
      "label": "Subheading - line 2"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Custom hero"
    }
  ]
}
{% endschema %}