<nav class="nav" aria-label="Primary">

  <div class="nav-left">
    <button
      class="hamburger show-hamburger"
      id="hamburger"
      aria-label="Open menu"
      aria-controls="mobileNav"
      aria-expanded="false"
    >
      <span class="hamburger-icon" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>

      <span class="cross-icon" aria-hidden="true">
        <span></span><span></span>
      </span>
    </button>
  </div>


  <div class="nav-mobile-logo">
    <a href="{{ routes.root_url }}">
      {% if settings.logo != blank %}
        {{
          settings.logo
          | image_url: width: 240
          | image_tag:
            alt: shop.name,
            loading: 'eager'
        }}
      {% else %}
        {{ shop.name }}
      {% endif %}
    </a>
  </div>


  <ul
    class="nav-menu"
    id="desktopMenu"
    role="menubar"
    aria-label="Primary"
  ></ul>


  <div class="nav-mobile-actions">

    <button
      type="button"
      class="nav-mobile-action nav-mobile-action--search"
      aria-label="Search"
    >
      <span aria-hidden="true">
        <!-- search icon -->
      </span>
    </button>


    {% if shop.customer_accounts_enabled %}
      <a
        href="{{ routes.account_url }}"
        class="nav-mobile-action"
        aria-label="Account"
      >
        <span aria-hidden="true">
          <!-- account icon -->
        </span>
      </a>
    {% endif %}


    <a
      href="{{ routes.cart_url }}"
      class="nav-mobile-action nav-mobile-action--basket"
      aria-label="Basket"
    >
      <span aria-hidden="true">
        <!-- basket icon -->
      </span>

      {% if cart.item_count > 0 %}
        <span class="nav-mobile-basket-count">
          {{ cart.item_count }}
        </span>
      {% endif %}
    </a>

  </div>


  <div
    class="mega-container"
    id="megaContainer"
    aria-live="polite"
  ></div>

</nav>


<div
  class="mobile-nav"
  id="mobileNav"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile menu"
>
  <div class="mobile-content">

    <div
      class="mobile-root"
      id="mobileRoot"
      aria-label="Main mobile menu container"
    >
      <div class="root-scroll" id="rootScroll">
        <ul
          class="mobile-menu"
          id="mobileMenu"
          aria-label="Main mobile menu"
        ></ul>
      </div>
    </div>

    <div id="mobilePanels"></div>

  </div>

  <div class="mobile-footer">
    <!-- footer content later -->
  </div>
</div>